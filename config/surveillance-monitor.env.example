# Wird von install.sh nach ~/.config/surveillance-monitor.env kopiert (chmod 600).
# Shell-Syntax: Werte mit Sonderzeichen in 'einfache Anführungszeichen' setzen.
NVR_HOST=192.168.1.100
NVR_USER='viewer'
NVR_PASS='changeme'
#NVR_PORT=554

# NVR-Kanäle (PoE-Ports), Reihenfolge: oben-links, oben-rechts, unten-links, unten-rechts
#CHANNELS="1 2 3 4"

#STREAM=sub        # sub (empfohlen) | main
#CODEC=h264        # h264 | h265 (nur Pfadname der Reolink-URL)

# Auflösung des Fernsehers
#SCREEN_W=1920
#SCREEN_H=1080

#RETRY_DELAY=5
#LOG_FILE="$HOME/.cache/surveillance-monitor.log"
